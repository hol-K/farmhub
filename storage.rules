rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Photos produits : products/{productId}.jpg
    // Lecture : utilisateurs connectés. Écriture : image JPEG/PNG < 2 Mo.
    // ponytail: pas de vérification du propriétaire côté Storage (nécessiterait firestore.get()) ;
    // à ajouter si des abus apparaissent.
    match /products/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
